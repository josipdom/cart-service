{
  "ConnectionStrings": {
    "CartDb": "Host=localhost;Port=5432;Database=cart;Username=cart;Password=cart",
    "Redis": "localhost:6379",
    "RabbitMq": "amqp://cart:cart@localhost:5672"
  },
  "Jwt": {
    "Issuer": "cart-service-dev",
    "Audience": "cart-service",
    "SigningKey": "local-development-signing-key-not-for-production-use-0123456789"
  },
  "Serilog": {
    "WriteTo": {
      "Elasticsearch": {
        "Name": "Elasticsearch",
        "Args": {
          "bootstrapMethod": "None",
          "nodes": [ "http://localhost:9200" ],
          "useSniffing": false,
          "dataStream": "logs-cartservice-default"
        }
      }
    }
  }
}
