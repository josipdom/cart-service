{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": {
      "Console": {
        "Name": "Console"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "cart-service"
    }
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": "00:01:00"
  },
  "AllowedHosts": "*"
}
